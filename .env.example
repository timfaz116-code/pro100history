# --- Способ 1: OpenAI / OpenRouter ---
# Получить ключ OpenAI: https://platform.openai.com/api-keys
# Получить ключ OpenRouter: https://openrouter.ai/keys
# OPENAI_API_KEY=sk-or-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=gpt-4o-mini

# --- Способ 2: Gemini API (бесплатно, 1500 запр/день) ---
# Получить ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.0-flash

# --- Общие настройки ---
# EMBEDDING_MODEL=text-embedding-3-small
