# --- GigaChat (рекомендую) ---
# Получить ключ: https://developers.sber.ru/portal/products/gigachat
# Бесплатный тариф: ~200 запросов/день
GIGACHAT_API_KEY=your_gigachat_api_key_here
LLM_MODEL=GigaChat-Plus

# --- OpenRouter (для эмбеддингов, нужен минимальный баланс) ---
# Получить ключ: https://openrouter.ai/keys
OPENAI_API_KEY=sk-or-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-small
