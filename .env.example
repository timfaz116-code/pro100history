# --- LLM провайдер ---
# Вариант 1: OpenRouter (доступен через OpenAI-совместимый API)
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-or-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
#
# Вариант 2: Gemini API (может быть заблокирован в РФ)
# LLM_MODEL=gemini-2.0-flash
# GEMINI_API_KEY=... # https://ai.google.dev/gemini-api/docs/api-key
#
# Для эмбеддингов (используется OpenRouter всегда):
EMBEDDING_MODEL=openai/text-embedding-3-small

# --- OpenRouter (для эмбеддингов, нужен минимальный баланс) ---
# Получить ключ: https://openrouter.ai/keys
OPENAI_API_KEY=sk-or-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-small
